LAMMPS (29 Oct 2020)
####################################################################################################
#
# TLSPH example:  elongate a 2d strip of a linear elastic material py pulling its ends apart
#
# unit system: GPa / mm / ms
#
####################################################################################################

####################################################################################################
# MATERIAL PARAMETERS
####################################################################################################
variable        E equal 1.0 # Young's modulus
variable        nu equal 0.3 # Poisson ratio
variable        rho equal 1 # initial mass density
variable        q1 equal 0.06 # standard artificial viscosity linear coefficient
variable        q2 equal 0.0  # standard artificial viscosity quadratic coefficient
variable        hg equal 50.0 # hourglass control coefficient
variable        cp equal 1.0 # heat capacity of material -- not used here
variable        FLAG_HYPER equal 1 # Hyperelastic flag

####################################################################################################
# INITIALIZE LAMMPS
####################################################################################################
dimension       3
units           si
boundary        sm sm sm # simulation box boundaries
atom_style      smd
atom_modify     map array
comm_modify     vel yes
neigh_modify    every 10 delay 0 check yes # re-build neighbor list every 10 steps
newton          off

####################################################################################################
# CREATE INITIAL GEOMETRY
####################################################################################################
variable        l0 equal 0.04 # lattice spacing for creating particles
lattice         sc ${l0}
lattice         sc 0.04
Lattice spacing in x,y,z = 0.04 0.04 0.04
region          box block 0 1.01 0 1.01 0 0.21 units box
create_box      1 box
Created orthogonal box = (0.0000000 0.0000000 0.0000000) to (1.0100000 1.0100000 0.21)
  2 by 2 by 1 MPI processor grid
create_atoms    1 box
Created 4056 atoms
  create_atoms CPU = 0.025 seconds
group           tlsph type 1
4056 atoms in group tlsph

####################################################################################################
# DISCRETIZATION PARAMETERS
####################################################################################################
variable        h equal 3.01*${l0} # SPH smoothing kernel radius
variable        h equal 3.01*0.04 
variable        vol_one equal ${l0}^3 # volume of one particle -- assuming unit thickness
variable        vol_one equal 0.04^3 
variable        skin equal ${h} # Verlet list range
variable        skin equal 0.1204 
neighbor        ${skin} bin
neighbor        0.1204 bin
set             group all volume ${vol_one}
set             group all volume 6.4e-05
Setting atom values ...
  4056 settings made for volume
set             group all smd/mass/density ${rho}
set             group all smd/mass/density 1
Setting atom values ...
  4056 settings made for smd/mass/density
set             group all diameter ${h} # set SPH kernel radius
set             group all diameter 0.1204 
Setting atom values ...
  4056 settings made for diameter

####################################################################################################
# DEFINE VELOCITY BOUNDARY CONDITIONS
####################################################################################################
variable        vel0 equal 0.005 # pull velocity
region          top block EDGE EDGE 0.965 EDGE EDGE EDGE units box
region          bot block EDGE EDGE EDGE 0.035 EDGE EDGE units box
group           top region top
156 atoms in group top
group           bot region bot
156 atoms in group bot
variable        vel_up equal ${vel0}  #*(1.0-exp(-0.01*time))
variable        vel_up equal 0.005  
variable        vel_down equal 0
fix             veltop_fix top smd/setvel 0 v_vel_up 0
fix             velbot_fix bot smd/setvel 0 v_vel_down 0

####################################################################################################
# INTERACTION PHYSICS / MATERIAL MODEL
####################################################################################################
pair_style      smd/tlsph
pair_coeff      1 1 *COMMON ${rho} ${E} ${nu} ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 ${E} ${nu} ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 ${nu} ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.06 ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.06 0 ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.06 0 50 ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.06 0 50 1 ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.06 0 50 1 1                 *STRENGTH_HGO                 *EOS_HGO                 *END

####################################################################################################
# TIME INTEGRATION
####################################################################################################
fix             dtfix tlsph smd/adjust_dt 0.1 # dynamically adjust time increment every step
fix             integration_fix tlsph smd/integrate_tlsph

####################################################################################################
# SPECIFY TRAJECTORY OUTPUT
####################################################################################################
compute         P all smd/tlsph/stress # Cauchy stress tensor
compute         E all smd/tlsph/strain # Green-Lagrange strain tensor
compute         nn all smd/tlsph/num/neighs # number of neighbors for each particle
dump            dump_id all custom 500 dump.LAMMPS id type x y z                c_P[1] c_P[2] c_P[3] c_P[4] c_P[5] c_P[6]

dump_modify     dump_id first yes

####################################################################################################
# STATUS OUTPUT
####################################################################################################
variable        stress equal 0.5*(f_velbot_fix[2]-f_veltop_fix[2])/20 # stress = force / initial width
variable        length equal xcm(top,y)-xcm(bot,y)
variable        strain equal (v_length-${length})/${length} # engineering strain
variable        strain equal (v_length-1)/${length} 
variable        strain equal (v_length-1)/1 
fix             stress_curve all print 200 "${length} ${strain} ${stress}" file stress_strain.dat screen no

thermo          100
thermo_style    custom step dt f_dtfix v_strain

####################################################################################################
# RUN SIMULATION
####################################################################################################
run             70000
Neighbor list info ...
  update every 10 steps, delay 0 steps, check yes
  max neighbors/atom: 2000, page size: 100000
