LAMMPS (29 Oct 2020)
####################################################################################################
#
# TLSPH example:  elongate a 2d strip of a linear elastic material py pulling its ends apart
#
# unit system: GPa / mm / ms
#
####################################################################################################

####################################################################################################
# MATERIAL PARAMETERS
####################################################################################################
variable        E equal 1.0 # Young's modulus
variable        nu equal 0.3 # Poisson ratio
variable        rho equal 1 # initial mass density
variable        q1 equal 0.01 # standard artificial viscosity linear coefficient
variable        q2 equal 0.0  # standard artificial viscosity quadratic coefficient
variable        hg equal 50.0 # hourglass control coefficient
variable        cp equal 1.0 # heat capacity of material -- not used here
variable        FLAG_HYPER equal 1 # Hyperelastic flag

####################################################################################################
# INITIALIZE LAMMPS
####################################################################################################
dimension       2
units           si
boundary        sm sm p # simulation box boundaries
atom_style      smd
atom_modify     map array
comm_modify     vel yes
neigh_modify    every 10 delay 0 check yes # re-build neighbor list every 10 steps
newton          off

####################################################################################################
# CREATE INITIAL GEOMETRY
####################################################################################################
read_data 	notch.data
Reading data file ...
  orthogonal box = (-0.1 -0.1 0.0000000) to (1.1000000 1.1000000 0.01)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  10124 atoms
  reading velocities ...
  10124 velocities
  read_data CPU = 0.016 seconds
region 		all block 0 1 0 1 0 0.01 units box
group           all region all
10124 atoms in group all
set             group all type 1
Setting atom values ...
  10124 settings made for type
group           tlsph union all
10124 atoms in group tlsph

####################################################################################################
# DISCRETIZATION PARAMETERS
####################################################################################################
variable 	l0 equal 0.01
variable        h equal 4.01*${l0} # SPH smoothing kernel radius
variable        h equal 4.01*0.01 
variable        vol_one equal 3.1415926*${l0}^2 # volume of one particle -- assuming unit thickness
variable        vol_one equal 3.1415926*0.01^2 
variable        skin equal 4.0*${l0} # Verlet list range
variable        skin equal 4.0*0.01 
neighbor        ${skin} bin
neighbor        0.04 bin
#set             group all volume ${vol_one}
#set             group all smd/mass/density ${rho}
#set             group all diameter ${h} # set SPH kernel radius

####################################################################################################
# DEFINE VELOCITY BOUNDARY CONDITIONS
####################################################################################################
variable        vel0 equal 0.005 # pull velocity
region          top block EDGE EDGE 0.985 EDGE EDGE EDGE units box
region          bot block EDGE EDGE EDGE 0.015 EDGE EDGE units box
group           top region top
202 atoms in group top
group           bot region bot
202 atoms in group bot
variable        vel_up equal ${vel0}
variable        vel_up equal 0.005
variable        vel_down equal 0
fix             veltop_fix top smd/setvel 0 v_vel_up 0
fix             velbot_fix bot smd/setvel 0 v_vel_down 0

####################################################################################################
# INTERACTION PHYSICS / MATERIAL MODEL
####################################################################################################
pair_style      smd/tlsph
pair_coeff      1 1 *COMMON ${rho} ${E} ${nu} ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 ${E} ${nu} ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 ${nu} ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 ${q1} ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.01 ${q2} ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.01 0 ${hg} ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.01 0 50 ${cp} ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.01 0 50 1 ${FLAG_HYPER}                 *STRENGTH_HGO                 *EOS_HGO                 *END
pair_coeff      1 1 *COMMON 1 1 0.3 0.01 0 50 1 1                 *STRENGTH_HGO                 *EOS_HGO                 *END

####################################################################################################
# TIME INTEGRATION
####################################################################################################
fix             dtfix tlsph smd/adjust_dt 0.1 # dynamically adjust time increment every step
fix             integration_fix tlsph smd/integrate_tlsph

####################################################################################################
# SPECIFY TRAJECTORY OUTPUT
####################################################################################################
compute         P all smd/tlsph/stress # PK1 stress tensor
compute         E all smd/tlsph/strain # Green-Lagrange strain tensor
compute         nn all smd/tlsph/num/neighs # number of neighbors for each particle
dump            dump_id all custom 1000 dump.LAMMPS id type x y z vx vy vz                 c_P[1] c_P[2] c_P[3] c_P[4] c_P[5] c_P[6]
dump_modify     dump_id first yes

####################################################################################################
# STATUS OUTPUT
####################################################################################################
variable        stress equal 0.5*(f_velbot_fix[2]-f_veltop_fix[2])/20 # stress = force / initial width
variable        length equal xcm(top,y)-xcm(bot,y)
variable        strain equal (v_length-${length})/${length} # engineering strain
variable        strain equal (v_length-0.990000000000001)/${length} 
variable        strain equal (v_length-0.990000000000001)/0.990000000000001 
fix             stress_curve all print 1000 "${length} ${strain} ${stress}" file stress_strain.dat screen no

thermo          1000
thermo_style    custom step dt f_dtfix v_strain

####################################################################################################
# RUN SIMULATION
####################################################################################################
run             50000
Neighbor list info ...
  update every 10 steps, delay 0 steps, check yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 0.1202
  ghost atom cutoff = 0.1202
  binsize = 0.0601, bins = 19 19 1
  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair smd/tlsph, perpetual
      attributes: half, newton off, size
      pair build: half/size/bin/newtoff
      stencil: half/bin/2d/newtoff
      bin: standard

TLSPH neighbors:
  max # of neighbors for a single particle = 196
  average # of neighbors/particle in group tlsph = 182.503
Per MPI rank memory allocation (min/avg/max) = 82.46 | 82.46 | 82.46 Mbytes
Step Dt f_dtfix v_strain 
       0        1e-16            0            0 
    1000 0.0025130949    2.